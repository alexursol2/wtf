# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# Keys may be given with or without the 0x prefix; both are normalised.

# ---------------------------------------------------------------------------
# Accounts. Signer order is DEPLOYER, MAKER, TAKER, AUDITOR in both Hardhat
# projects, and the deploy scripts index on that order.
# ---------------------------------------------------------------------------

# Carries the T-REX suite (~20M gas) plus redeploys. Needs the most ETH.
PRIVATE_KEY_DEPLOYER=

# Posts asks and reports trades. ~1M gas per trade cycle.
PRIVATE_KEY_MAKER=

# Fills. ~0.92M gas per trade. MUST differ from the maker: DeferralVenue
# rejects a self-fill, because with maker == taker both sides of the cash
# transfer land in one storage slot.
PRIVATE_KEY_TAKER=

# The regulator. Needs NO ETH — it sends no transactions. Decryption is an
# off-chain signed request to the gateway. Must differ from maker and taker,
# or the selective-disclosure demo proves nothing.
PRIVATE_KEY_AUDITOR=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARB_RPC_URL=https://arbitrum-sepolia-rpc.publicnode.com

# For contract verification, so judges can read the deployed source.
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Deploy outputs — leave blank, they are filled in after each stage.
# Addresses are also written to deployments/*.json automatically.
# ---------------------------------------------------------------------------

# From the T-REX deploy (Layer 1). Required by the Nox deploy on a live chain.
IDENTITY_REGISTRY=
BOND_TOKEN=

# Optional override. Defaults to the address derived from PRIVATE_KEY_AUDITOR.
AUDITOR=

# T-REX: false for the first pass (isVerified returns true with zero claim
# topics, which gets the pipeline green), then true for the second pass.
WITH_CLAIMS=false

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

VITE_CHAIN_ID=11155111
VITE_VENUE=
VITE_SHARES_WRAPPER=
VITE_CASH_WRAPPER=

# Read-only reads before a wallet connects — the book, the tape, compliance.
# Optional, but a public endpoint rate-limits hard enough that the book looks
# empty rather than slow. Same URL as RPC_URL above; the prefix is what makes
# Vite expose it to the browser.
VITE_RPC_URL=

# There is deliberately NO token address here. The instrument tokens live in
# frontend/src/reference.ts beside their wrappers, and the cash token beside
# them as CASH_TOKEN. A contract address is not a secret and not a
# per-environment choice, so an env var for it was only something to forget —
# and when it was forgotten the wallet balance silently failed to read.

# Required to encrypt inputs in the browser via the Nox handle SDK.
VITE_NOX_GATEWAY_URL=https://gateway-testnets.noxprotocol.dev

# Indexes Nox handles. Avoids enumerating logs from block 0 on a public RPC.
VITE_NOX_SUBGRAPH_URL=
