# Copy to .env and fill in. NEVER commit the real file.

# Deployer key. Use a throwaway testnet key, not a personal wallet.
PRIVATE_KEY=

# RPC endpoints. Both default to public nodes if unset.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARB_RPC_URL=https://arbitrum-sepolia-rpc.publicnode.com

# --- Nox sub-project deploy (scripts/deploy.ts) ---
# Required on any live network — deploy Layer 1 first and paste its address.
IDENTITY_REGISTRY=
# Optional: the T-REX token. A MockERC20 is deployed if omitted.
BOND_TOKEN=
# Optional: the regulator address. Defaults to the deployer.
AUDITOR=

# --- T-REX sub-project deploy (scripts/deploy-trex.ts) ---
# Set to true for the second pass, which registers a claim topic and issuer.
WITH_CLAIMS=false

# --- frontend ---
VITE_VENUE=
VITE_CHAIN_ID=11155111
VITE_SHARES_WRAPPER=
VITE_CASH_WRAPPER=
# Required to encrypt inputs in the browser via the Nox handle SDK.
VITE_NOX_GATEWAY_URL=
